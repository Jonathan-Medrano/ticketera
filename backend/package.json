{
  "name": "platea-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "powershell -Command \"node ./scripts/prepare-test-db.cjs; if ($?) { node --import tsx --import ./src/test-env.ts --test --test-concurrency=1 src/**/*.test.ts }\"",
    "test:checkout": "powershell -Command \"node ./scripts/prepare-test-db.cjs; if ($?) { node --import tsx --import ./src/test-env.ts --test --test-concurrency=1 src/checkout-cleanup.test.ts src/tenant-payment-hardening.test.ts }\"",
    "test:cleanup": "powershell -Command \"node ./scripts/prepare-test-db.cjs; if ($?) { node --import tsx --import ./src/test-env.ts --test --test-concurrency=1 src/checkout-cleanup.test.ts src/expired-checkout-cleanup-job.test.ts }\"",
    "test:postgres:up": "docker compose -f docker-compose.test.yml up -d postgres-test",
    "test:postgres:down": "docker compose -f docker-compose.test.yml down -v",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:clean": "node scripts/seed-demo-clean.mjs",
    "seed:superadmin-demo": "tsx scripts/seed-superadmin-demo.ts",
    "seed:events-demo": "tsx scripts/seed-events-demo.ts",
    "seed:sitio-venta-demo": "tsx scripts/seed-sitio-venta-demo.ts",
    "backfill:velocity": "tsx scripts/backfillVelocitySnapshots.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx ./prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.106.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "mercadopago": "^2.0.6",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "pg": "^8.13.3",
    "prisma": "^5.22.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "svix": "1.92.2"
  }
}
