// ---- Domain: platform settings (singleton) ----

// Configuración global de la plataforma. Tabla singleton: una sola fila con
// id = 'singleton'. Hoy controla la auto-aprobación de empresas en el registro
// público (si está activa, las empresas nuevas quedan aprobadas sin intervención).
model PlatformSetting {
  id                    String   @id @db.VarChar(36)
  auto_aprobar_empresas Boolean  @default(false)
  // Gate de la vidriera cross-tenant. Es un LATCH: se enciende solo cuando hay 2+
  // empresas elegibles con eventos listados, y una vez encendido NO se apaga aunque
  // el conteo vuelva a bajar. Motivo: /eventos es una pagina publica indexable — si
  // apareciera y desapareciera segun cuantas empresas hay en ese momento, romperia
  // el SEO y todos los links ya compartidos.
  vidriera_habilitada    Boolean   @default(false)
  vidriera_habilitada_at DateTime? @db.Timestamptz()
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz()
  updated_by            String?  @db.VarChar(36)

  @@map("platform_settings")
}

// ---- Domain: Victoria (asistente) telemetría ----

// Feedback del asistente Victoria capturado desde el browser (browser → BFF → backend),
// fire-and-forget. Append-only, sólo para descubrir vocabulario faltante y medir votos.
// PRIVACIDAD: sin user_id, sin IP, sin email — sólo empresa_id (de la sesión autenticada).
// query_text/topic_id/ruta van capados y con control-chars stripeados en la capa de ruta.
//   tipo='fallback' → query_text = texto buscado sin respuesta; topic_id/voto NULL.
//   tipo='voto'     → topic_id + voto ('up'|'down'); query_text NULL.
// Sin @relation a Empresa: el schema entero es relation-less y ninguna tabla declara FK a
// empresas (mismo patrón que waitlist_entries, error_logs, etc.). El scoping es a nivel app.
model VictoriaTelemetria {
  id        BigInt   @id @default(autoincrement())
  empresaId String   @map("empresa_id") @db.VarChar(36)
  tipo      String   @db.VarChar(20)
  queryText String?  @map("query_text") @db.VarChar(200)
  topicId   String?  @map("topic_id") @db.VarChar(100)
  voto      String?  @db.VarChar(10)
  ruta      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([empresaId, createdAt])
  @@index([tipo, createdAt])
  @@map("victoria_telemetria")
}
