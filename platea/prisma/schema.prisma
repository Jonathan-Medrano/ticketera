// ---- Domain: comisiones por volumen (fee tiers) ----
//
// Motor que ajusta la comisión de una empresa segun su volumen real de ventas.
// Ver openspec/changes/fee-tiers-por-volumen/.
//
// El motor NO toca el camino del dinero: escribe en
// empresa_marketplace_fee_overrides y la cascada de resolucion existente
// (lib/marketplace-fee.ts) hace el resto. La comision se congela en
// checkout_sessions al crear la sesion, asi que un cambio de tier nunca puede
// alterar retroactivamente una venta ya cobrada.

// Escalera de comisiones por volumen. Editable desde super-admin SIN deploy:
// un umbral de comision es un parametro comercial, no una constante de codigo.
model PlatformFeeTier {
  id String @id @db.VarChar(36)

  nombre String @db.VarChar(60)

  // Entradas online no canceladas en ventana rolling de 90 dias.
  // En CANTIDAD, no en ARS: un umbral en pesos se autodesactualiza con la
  // inflacion argentina (en ~1 año todas las empresas serian "alto volumen"
  // sin haber vendido una entrada mas).
  min_entradas_90d Int

  pct_entradas    Decimal @db.Decimal(5, 2)
  pct_consumibles Decimal @db.Decimal(5, 2)

  // Arranca en false: el codigo se despliega apagado y se activa a mano
  // recien despues de verificar los conteos en produccion.
  activo Boolean @default(false)
  orden  Int     @default(0)

  created_at DateTime @default(now()) @db.Timestamptz()
  // @updatedAt informational only — real updates via trigger
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@unique([min_entradas_90d])
  @@index([activo, min_entradas_90d])
  @@map("platform_fee_tiers")
}

// Estado de tier por empresa. empresa_id es la PK (no un id sintetico + unique):
// una empresa tiene exactamente un estado, y asi la base garantiza el invariante
// sin codigo que lo defienda.
model EmpresaFeeTierState {
  empresa_id String @id @db.VarChar(36)

  current_tier_id  String?   @db.VarChar(36)
  entradas_ventana Int       @default(0)
  evaluated_at     DateTime? @db.Timestamptz()

  // Descenso detectado y NO aplicado — espera aprobacion humana (ratchet).
  // Bajarle la comision a alguien no requiere su consentimiento; subirsela si.
  pending_downgrade_tier_id String?   @db.VarChar(36)
  pending_desde             DateTime? @db.Timestamptz()

  // Comision negociada a mano: el job NUNCA la toca, en ninguna direccion.
  pinned        Boolean @default(false)
  pinned_por    String? @db.VarChar(36)
  pinned_motivo String? @db.VarChar(200)

  // @updatedAt informational only — real updates via trigger
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@index([pending_downgrade_tier_id])
  @@index([pinned])
  @@map("empresa_fee_tier_state")
}

// Auditoria inmutable (solo INSERT). En codigo que mueve plata hay que poder
// responder "¿por que esta empresa pago 3,5% el 12 de marzo?".
model EmpresaFeeTierEvent {
  id         String @id @db.VarChar(36)
  empresa_id String @db.VarChar(36)
  flow       String @db.VarChar(40)

  pct_anterior Decimal? @db.Decimal(5, 2)
  pct_nuevo    Decimal  @db.Decimal(5, 2)

  tier_id     String? @db.VarChar(36)
  tier_nombre String? @db.VarChar(60)

  // Conteo que motivo la decision — hace cada evaluacion reproducible.
  entradas_ventana Int

  // 'system' (job) | 'admin' (aprobacion manual de un descenso)
  origen       String  @db.VarChar(20)
  aplicado_por String? @db.VarChar(36)

  created_at DateTime @default(now()) @db.Timestamptz()

  @@index([empresa_id, created_at])
  @@index([origen])
  @@map("empresa_fee_tier_events")
}

