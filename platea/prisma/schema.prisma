  @@index([created_at(sort: Desc)])
  @@index([actor_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

model ErrorLog {
  id              Int       @id @default(autoincrement())
  fingerprint     String    @unique @db.VarChar(64)
  source          String    @db.VarChar(20)
  severity        String    @db.VarChar(20)
  message         String    @db.Text
  stack           String?   @db.Text
  context         Json?     @db.JsonB
  user_agent      String?   @db.VarChar(500)
  ip_address      String?   @db.VarChar(45)
  count_total     Int       @default(1)
  first_seen_at   DateTime  @default(now()) @db.Timestamptz()
  last_seen_at    DateTime  @default(now()) @db.Timestamptz()
  resolved_at     DateTime? @db.Timestamptz()
  resolved_by     String?   @db.VarChar(36)
  // Última vez que se despachó una alerta por email para este fingerprint.
  // Gobierna el cooldown anti-spam: re-alertamos un error recurrente como mucho
  // una vez por ventana de cooldown.
  last_alerted_at DateTime? @db.Timestamptz()

  @@index([last_seen_at(sort: Desc)])
  @@index([source, last_seen_at(sort: Desc)])
  @@index([resolved_at, last_seen_at(sort: Desc)])
  @@map("error_logs")
}

